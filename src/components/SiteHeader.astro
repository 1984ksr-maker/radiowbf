---
// The header IS the radio. It stays at the top of every page and keeps playing
// while people move around the site (transition:persist).
import site from '../data/site.json';
import { liveChannel, channels } from '../lib/live';
import { t } from '../lib/t';

const nav = [
  { href: '/listen', label: t.navPlayer },
  { href: '/shows', label: t.navArchive },
  { href: '/schedule', label: t.navSchedule },
  { href: '/chat', label: t.navChat },
  { href: '/about', label: t.navAbout },
  { href: '/support', label: t.navSupport },
];
---
<header id="wbf-player" class="head" transition:persist="wbf-head" data-mode="idle" data-from-archive={t.fromArchive} data-quiet={t.quiet}>
  <div class="air wrap">
    <button class="live" id="pp" type="button" aria-label={`Play ${liveChannel.name} live`}>
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      <svg class="i-stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="7" width="10" height="10" fill="currentColor" /></svg>
      <span class="live-word">{t.live}</span>
    </button>
    <span class="onair"><span class="dot" aria-hidden="true"></span>{t.onAir}</span>
    <div class="ticker" aria-live="polite">
      <div class="ticker-move"><span id="p-now">{site.name} · {liveChannel.name} · {liveChannel.label}</span><span class="dup" aria-hidden="true"></span></div>
    </div>
    <div class="chans" role="group" aria-label="Channels">
      {channels.map((c, i) => (
        <button type="button" class="ch" data-live={c.id} title={`${c.name}, ${c.label}`} aria-label={`${c.name}, ${c.label}`}>{i + 1}</button>
      ))}
    </div>
    <a class="chat-link" href="/chat" aria-label="Community chat" title="Community chat">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <div class="bar wrap">
    <a class="logo" href="/" aria-label={`${site.name}, start page`}>
      <img src={site.logo} alt="" width="56" height="55" />
      <span class="word">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="insta" href={site.instagram} rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" /></svg>
    </a>
    {(site as any).telegram && (
      <a class="insta" href={(site as any).telegram} rel="noopener" aria-label="Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 3.6 2.9 10.8c-1 .4-1 1.6.1 1.9l4.6 1.4 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.8 3.5c.6.4 1.4.1 1.6-.6L22.9 5c.2-1-.6-1.8-1.4-1.4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="m7.8 14.2 9.6-6.3-7.3 7.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      </a>
    )}
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu={t.menu} data-close={t.close}>{t.menu}</button>
  </div>

  <div id="menu" class="menu wrap" hidden>
    <ul>
      <li><a href="/">{t.navListen}</a></li>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
    <p class="menu-social">
      <a href={site.instagram} rel="noopener">Instagram</a>
      {(site as any).telegram && <a href={(site as any).telegram} rel="noopener">Telegram</a>}
    </p>
    <p class="menu-ch">
      {channels.map((c, i) => (
        <button type="button" class="ch ch-wide" data-live={c.id}>{i + 1} · {c.label}</button>
      ))}
    </p>
  </div>

  <div id="player-embed" class="embed wrap"></div>
</header>

<script>
  import { startPlayer, getState, playLive, stop } from '../lib/player';

  startPlayer();

  const $ = (id: string) => document.getElementById(id)!;
  const head = $('wbf-player');
  const pp = $('pp');
  const nowEl = $('p-now');
  const dup = head.querySelector<HTMLElement>('.dup')!;
  const menuBtn = head.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = $('menu');
  let now: any = null;

  pp.addEventListener('click', () => {
    const s = getState();
    if (s.mode === 'idle') playLive(s.channel.id);
    else stop();
  });

  menuBtn.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.textContent = (open ? menuBtn.dataset.close : menuBtn.dataset.menu) ?? '';
    fitBody();
  });

  function setText(t: string) {
    nowEl.textContent = t;
    dup.textContent = t;
  }

  function fitBody() {
    if (document.documentElement.classList.contains('popup')) return;
    document.body.style.paddingTop = `${head.offsetHeight}px`;
  }

  function render() {
    const s = getState();
    head.dataset.mode = s.mode;
    head.classList.toggle('loading', s.loading);
    pp.setAttribute('aria-label', s.mode === 'idle' ? `Play ${s.channel.name} live` : 'Stop');
    if (s.mode === 'embed') {
      setText(`${head.dataset.fromArchive} · ${s.embedTitle || ''}`);
    } else if (s.channel.airtimeInfo && now?.show) {
      setText(`${s.channel.name} · ${now.show}${now.track ? ` · ${now.track}` : ''}`);
    } else {
      setText(`${s.channel.name} · ${s.channel.label}`);
    }
    fitBody();
  }

  function markNav() {
    const path = location.pathname.replace(/\/$/, '') || '/';
    head.querySelectorAll<HTMLAnchorElement>('.nav a, .menu a').forEach((a) => {
      const href = a.getAttribute('href')!;
      const on = href === '/' ? path === '/' : path.startsWith(href);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    menu.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.textContent = menuBtn.dataset.menu ?? '';
  }

  document.addEventListener('wbf:state', render);
  document.addEventListener('wbf:now', (e) => { now = (e as CustomEvent).detail; render(); });
  document.addEventListener('wbf:error', (e) => {
    setText(`${(e as CustomEvent).detail.name} ${head.dataset.quiet}`);
  });
  document.addEventListener('astro:page-load', () => { markNav(); render(); });
  new ResizeObserver(fitBody).observe(head);
  render();
</script>

<style>
  .head { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: var(--paper); border-bottom: 2px solid var(--ink); }

  /* the black on air strip */
  .air { display: flex; align-items: center; gap: 16px; height: 68px; background: var(--ink); color: var(--paper); }
  .live {
    flex: 0 0 auto; height: 52px; min-width: 170px; padding: 0 28px 0 22px; border-radius: 999px; border: 0;
    background: var(--wbf); color: var(--on-wbf); font: inherit; font-size: 1.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: .01em;
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: transform .2s ease;
  }
  .live:hover { background: var(--paper); transform: scale(1.04); }
  .i-play { width: 28px; height: 28px; }
  .i-stop { width: 30px; height: 30px; display: none; }
  .head:not([data-mode='idle']) .i-play { display: none; }
  .head:not([data-mode='idle']) .i-stop { display: block; }
  .head:not([data-mode='idle']) .live { animation: ring 1.8s infinite; }
  @keyframes ring { 0% { box-shadow: 0 0 0 0 rgba(240, 89, 47, .7); } 70% { box-shadow: 0 0 0 14px rgba(240, 89, 47, 0); } 100% { box-shadow: 0 0 0 0 rgba(240, 89, 47, 0); } }
  .head.loading .live { opacity: .75; }
  .onair { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; font-weight: 700; text-transform: uppercase; font-size: .9rem; letter-spacing: .06em; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--wbf); animation: blink 1.3s infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .ticker { flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; font-size: 1.05rem; mask-image: linear-gradient(90deg, transparent, #000 2%, #000 95%, transparent); }
  .ticker-move { display: inline-flex; gap: 60px; padding-left: 10px; animation: tick 28s linear infinite; }
  .ticker:hover .ticker-move { animation-play-state: paused; }
  @keyframes tick { to { transform: translateX(calc(-50% - 30px)); } }
  .chans { display: flex; gap: 6px; flex: 0 0 auto; }
  .ch {
    width: 34px; height: 34px; border-radius: 50%; border: 2px solid currentColor;
    background: transparent; color: inherit; font: inherit; font-weight: 700; font-size: .9rem; cursor: pointer;
  }
  .ch:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .ch[aria-pressed='true'] { background: var(--wbf); border-color: var(--wbf); color: var(--on-wbf); }
  .chat-link, .insta { flex: 0 0 auto; display: grid; place-items: center; width: 36px; height: 36px; color: inherit; }
  .chat-link svg, .insta svg { width: 26px; height: 26px; }
  .chat-link:hover { color: var(--wbf); }

  /* the white name and menu row */
  .bar { display: flex; align-items: center; gap: 20px; height: 70px; }
  .logo { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .logo:hover { color: inherit; }
  .logo img { width: 54px; height: auto; transition: transform .6s ease; }
  .logo:hover img { transform: rotate(-16deg); }
  .word { font-size: 1.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: -.03em; line-height: 1; }
  .nav ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-size: 1.02rem; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; }
  .nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 8px; text-decoration-color: var(--wbf); }
  .insta:hover { color: var(--wbf-text); }
  .menu-social { display: flex; gap: 22px; margin: 18px 0 0; font-weight: 700; text-transform: uppercase; }
  .menu-social a { text-decoration: none; }

  .menu-btn {
    display: none; flex: 0 0 auto; font: inherit; font-weight: 700; font-size: .95rem; letter-spacing: .06em; text-transform: uppercase;
    background: none; border: 2px solid var(--ink); border-radius: 999px; padding: 4px 14px; color: var(--ink); cursor: pointer;
  }
  .menu { border-top: 2px solid var(--ink); }
  .menu ul { list-style: none; margin: 0; padding: 10px 0 18px; }
  .menu a { display: block; font-size: 2.4rem; font-weight: 700; text-transform: uppercase; letter-spacing: -.02em; text-decoration: none; padding: 2px 0; }
  .menu a[aria-current='page'] { color: var(--wbf-text); }
  .menu-ch { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .menu .ch { color: var(--ink); }
  .ch-wide { width: auto; height: auto; border-radius: 999px; padding: 4px 14px; }

  .embed:empty { display: none; }
  .embed { padding: 10px var(--gutter); border-top: 2px solid var(--ink); background: var(--paper-2); }
  .embed :global(iframe) { width: 100%; border: 0; display: block; }

  @media (max-width: 1080px) {
    .nav, .insta { display: none; }
    .menu-btn { display: block; }
  }
  @media (max-width: 700px) {
    .air { gap: 10px; height: 60px; }
    .live { height: 44px; min-width: 110px; padding: 0 16px 0 12px; font-size: 1.35rem; gap: 6px; }
    .i-play, .i-stop { width: 20px; height: 20px; }
    .onair, .chans { display: none; }
    .ticker { font-size: .92rem; }
    .bar { height: 58px; }
    .logo img { width: 42px; }
    .word { font-size: 1.4rem; }
  }
</style>
