---
import type { ArchiveItem } from '../lib/mixcloud';
import { dotDate, slugify } from '../lib/shows';
import site from '../data/site.json';

interface Props { item: ArchiveItem; eager?: boolean }
const { item, eager = false } = Astro.props;
const cats = item.categories.map(slugify).join(' ');
const rel = item.external ? 'noopener' : undefined;
---
<article class="card" data-cats={cats}>
  <div class="media">
    <a class="img" href={item.href} rel={rel} tabindex="-1" aria-hidden="true">
      {item.image
        ? <img src={item.image} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        : <span class="blank"><img src={site.logo} alt="" /></span>}
    </a>
    {item.play && (
      <button class="play" type="button" data-embed={item.play.kind} data-url={item.play.url} data-title={item.title} aria-label={`Listen to ${item.title}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </button>
    )}
  </div>
  <h3><a href={item.href} rel={rel}>{item.title}</a></h3>
  <p class="date"><time datetime={item.date.toISOString()}>{dotDate(item.date)}</time></p>
  <ul class="pills">
    {item.categories.map((c) => <li><a class="pill" href={`/shows?c=${slugify(c)}`}>{c}</a></li>)}
    {item.source && <li><span class="pill">{item.source}</span></li>}
  </ul>
</article>

<style>
  .card { min-width: 0; }
  .media { position: relative; margin-bottom: 12px; }
  .img { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: var(--paper-2); border: 2px solid var(--ink); }
  .img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease, filter .6s ease; }
  .card:hover .img img { transform: scale(1.04); }
  .blank { display: grid; place-items: center; height: 100%; }
  .blank img { width: 42%; height: auto; }
  .play {
    position: absolute; right: 12px; bottom: 12px; width: 58px; height: 58px; border-radius: 50%;
    border: 2px solid var(--ink); background: var(--wbf); color: var(--on-wbf); cursor: pointer; display: grid; place-items: center;
    transition: transform .2s ease;
  }
  .play svg { width: 26px; height: 26px; margin-left: 3px; }
  .play:hover { transform: scale(1.1) rotate(-8deg); }
  .play.is-playing { background: var(--ink); color: var(--wbf); }
  h3 { font-size: 1.25rem; line-height: 1.12; margin: 0 0 4px; }
  h3 a { text-decoration: none; }
  .date { margin: 0 0 8px; font-size: .95rem; color: var(--ink-soft); }
</style>
