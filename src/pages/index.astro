---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import LivePanel from '../components/LivePanel.astro';
import ShowCard from '../components/ShowCard.astro';
import Marquee from '../components/Marquee.astro';
import WeekSchedule from '../components/WeekSchedule.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { getArchive } from '../lib/shows';
import site from '../data/site.json';
import { t } from '../lib/t';

const archive = await getArchive();
// The slider always shows the four newest posts that have a picture (SoundCloud uploads included).
const hero = archive.filter((a) => a.image).slice(0, 4);
// Eight newest posts in the grid. Everything else lives in the archive.
const fresh = archive.slice(0, 8);
const supportLink = site.support.link || '/support';
---
<Base>
  <HeroSlider items={hero} />

  <Marquee text={site.home.freshTitle} href="/shows" linkText={site.home.archiveButton} />
  <section class="grid">
    {fresh.map((item, i) => <ShowCard item={item} eager={i < 4} />)}
  </section>

  <Marquee text={site.home.scheduleTitle} icon="◷" href="/schedule" linkText={t.weekLink} />
  <section class="two">
    <div class="sched"><WeekSchedule /></div>
    <aside class="chat">
      <p class="chat-title">{site.home.chatTitle} <span class="dot" aria-hidden="true"></span></p>
      <iframe src={site.chat} title="RadioWBF community chat" loading="lazy"></iframe>
    </aside>
  </section>

  {site.home.posterShow && (
    <section class="poster">
      <div class="poster-in">
        {site.home.posterKicker && <p class="kicker">{site.home.posterKicker}</p>}
        <h2>{site.home.posterTitle}</h2>
        <p class="poster-text">{site.home.posterText}</p>
        {site.home.posterButton && <p><a class="btn btn-dark" href={site.home.posterLink || site.instagram} rel="noopener">{site.home.posterButton}</a></p>}
      </div>
      <img class="poster-logo" src={site.home.posterImage || site.logo} alt="" loading="lazy" />
    </section>
  )}

  <Marquee text={site.player.sectionTitle} icon="▶" href="/listen" linkText={t.playerLink} />
  <section class="tune"><LivePanel /></section>

  <InstagramFeed />

  {site.support.show && (
    <section class="support">
      <h2>{site.support.title}</h2>
      <p>{site.support.text}</p>
      <p><a class="btn" href={supportLink} rel={site.support.link ? 'noopener' : undefined}>{site.support.button}</a></p>
    </section>
  )}
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; padding: 26px 0 50px; }

  .two { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr); gap: 30px; padding: 30px 0 60px; }
  .chat { border: 2px solid var(--ink); display: flex; flex-direction: column; min-height: 640px; }
  .chat-title { margin: 0; padding: 10px 14px; border-bottom: 2px solid var(--ink); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--wbf); animation: blink 1.3s infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .chat iframe { flex: 1 1 auto; width: 100%; border: 0; min-height: 600px; }

  .poster {
    position: relative; overflow: hidden; margin: 10px calc(var(--gutter) * -1) 0;
    background: var(--wbf); color: var(--on-wbf); border-top: 2px solid var(--ink);
    padding: clamp(36px, 7vw, 100px) var(--gutter);
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 30px; align-items: center;
  }
  .kicker { text-transform: uppercase; letter-spacing: .1em; font-size: .9rem; font-weight: 700; }
  .poster h2 { font-size: clamp(3rem, 8vw, 7.5rem); text-transform: uppercase; line-height: .9; margin-bottom: 26px; letter-spacing: -.035em; }
  .poster-text { font-size: 1.2rem; max-width: 34em; font-weight: 500; }
  .btn-dark { border-color: var(--on-wbf); color: var(--on-wbf); }
  .btn-dark:hover { background: var(--ink); color: var(--wbf); }
  .poster-logo { width: 100%; max-width: 380px; justify-self: end; animation: wobble 8s ease-in-out infinite; }
  @keyframes wobble { 50% { transform: rotate(-12deg) scale(1.04); } }

  .tune { padding: 20px 0 40px; }

  .support { text-align: center; padding: 70px 0 30px; max-width: 760px; margin: 0 auto; }
  .support h2 { font-size: clamp(2.2rem, 5vw, 4rem); text-transform: uppercase; margin-bottom: 18px; }
  .support p { font-size: 1.15rem; }

  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .poster { grid-template-columns: 1fr; }
    .poster-logo { max-width: 200px; justify-self: start; }
  }
  @media (max-width: 480px) { .grid { gap: 14px; } }
</style>
